# временные файлы диагностики браузера и серверов
.tmp/
tools/certs/
node_modules/
package-lock.json

# рабочие каталоги распознавания и стенда точности
.omr-bench/
.omr-work/
.piptmp/
server/deps/
# локальные зависимости для проверки Gradio-пространства (gradio ставится только ради этого теста)
server/deps-gradio/

# готовые звуковые файлы для прослушивания (создаются npm run render:wav)
artifacts/

# собранные пакеты для хостинга (создаются npm run build:static / npm run pack:space[:gradio])
dist/
dist-space/
dist-space-gradio/

# Python
__pycache__/
*.pyc
.venv/
venv/

# редакторы и ОС
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ваши сканы из папки «Ноты для проверок» (материал сборников — не для публикации в репозитории).
